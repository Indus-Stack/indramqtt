{
  "name": "indramqtt-docs-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static site for the IndraMQTT user documentation in docs/.",
  "license": "MIT",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "dev": "npm run sync-docs && astro dev",
    "build": "npm run sync-docs && astro build",
    "test": "node --test \"test/*.test.mjs\"",
    "check-links": "python3 ../tools/check_site_links.py dist"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.30.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^5.0.0",
    "sharp": "^0.33.0"
  }
}
