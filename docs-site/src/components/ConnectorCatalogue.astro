---
import connectors from '../data/connectors.json';

const categories = ['All', ...new Set(connectors.map((c) => c.category))];
---

<div class="connector-catalogue not-content">
  <div class="catalogue-controls">
    <div class="search-box">
      <label for="connector-search" class="sr-only">Filter connectors by name or alias</label>
      <input
        type="search"
        id="connector-search"
        class="search-input"
        placeholder="Filter by name or alias..."
        aria-controls="connector-grid"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <div class="category-chips" role="group" aria-label="Filter by category">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            class={`category-chip ${idx === 0 ? 'active' : ''}`}
            data-category={cat === 'All' ? 'all' : cat}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <div id="catalogue-count" class="catalogue-count" role="status" aria-live="polite">
      Showing {connectors.length} connectors
    </div>
  </div>

  <div id="connector-grid" class="connector-grid">
    {
      connectors.map((c) => (
        <a
          href={`/connectors/${c.page}/`}
          class={`connector-card ${c.state === 'Not in this build' ? 'muted' : ''}`.trim()}
          data-kind={c.kind.toLowerCase()}
          data-title={c.title.toLowerCase()}
          data-aliases={c.aliases.join(' ').toLowerCase()}
          data-category={c.category}
        >
          <article class="card-inner">
            <div class="card-header">
              <span class="card-category">{c.category}</span>
              <span class={`state-badge state-${c.state.toLowerCase().replace(/\s+/g, '-')}`}>
                {c.state}
              </span>
            </div>
            <h3 class="card-title">{c.title}</h3>
            <p class="card-description">{c.description}</p>
          </article>
        </a>
      ))
    }
  </div>
</div>

<script>
  function initCatalogue() {
    const searchInput = document.getElementById('connector-search');
    const chipButtons = document.querySelectorAll('.category-chip');
    const countEl = document.getElementById('catalogue-count');
    const cards = document.querySelectorAll('.connector-card');

    if (!searchInput || !cards.length) return;

    let selectedCategory = 'all';
    let searchQuery = '';

    function updateFilter() {
      const q = searchQuery.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const kind = card.getAttribute('data-kind') || '';
        const aliases = card.getAttribute('data-aliases') || '';
        const category = card.getAttribute('data-category') || '';

        const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
        const matchesSearch = !q || title.includes(q) || kind.includes(q) || aliases.includes(q);

        if (matchesCategory && matchesSearch) {
          card.classList.remove('is-hidden');
          visible++;
        } else {
          card.classList.add('is-hidden');
        }
      });

      if (countEl) {
        if (visible === cards.length) {
          countEl.textContent = `Showing ${visible} connectors`;
        } else {
          countEl.textContent = `Showing ${visible} of ${cards.length} connectors`;
        }
      }
    }

    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      updateFilter();
    });

    chipButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        chipButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        selectedCategory = btn.getAttribute('data-category') || 'all';
        updateFilter();
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCatalogue);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initCatalogue();
  }
</script>

<style>
  .connector-catalogue {
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .catalogue-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .search-input {
    width: 100%;
    max-width: 480px;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-text);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.15s ease;
  }
  .search-input:focus {
    border-color: var(--sl-color-accent);
  }
  .category-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .category-chip {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 9999px;
    padding: 0.3rem 0.85rem;
    font-size: 0.825rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-text);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .category-chip:hover {
    border-color: var(--sl-color-accent);
  }
  .category-chip.active {
    background-color: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    border-color: var(--sl-color-accent);
    font-weight: 500;
  }
  .catalogue-count {
    font-size: 0.875rem;
    color: var(--sl-color-gray-4);
  }
  .connector-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .connector-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.15s ease;
  }
  .connector-card:hover {
    transform: translateY(-2px);
  }
  .connector-card:hover .card-inner {
    border-color: var(--sl-color-accent);
  }
  .card-inner {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    padding: 1.25rem;
    background-color: var(--sl-color-black);
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.15s ease;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .card-category {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }
  .state-badge {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-weight: 500;
  }
  .state-ready {
    background-color: var(--sl-color-accent-low, #083344);
    color: var(--sl-color-text-accent, #00D8F6);
    border: 1px solid var(--sl-color-accent, #00D8F6);
  }
  .state-pending {
    background-color: #451a03;
    color: #fb923c;
    border: 1px solid #f97316;
  }
  .state-not-in-this-build {
    background-color: var(--sl-color-gray-6, #27272A);
    color: var(--sl-color-gray-3, #D4D4D8);
    border: 1px solid var(--sl-color-gray-5, #3F3F46);
  }
  .card-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
  }
  .card-description {
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    margin: 0;
    line-height: 1.5;
  }
  .is-hidden {
    display: none !important;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
